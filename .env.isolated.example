# 独立验收环境固定端口（由 scripts/start-isolated-demo.sh 管理）
BACKEND_PORT=5010
OAUTH_PORT=5110
FRONTEND_PORT=5190
OPERATIONS_PORT=5192

# 浏览器统一访问前端同源地址；Vite 仅在本机转发到下面两个服务。
LOCAL_BACKEND_PROXY_TARGET=http://127.0.0.1:5010
LOCAL_OAUTH_PROXY_TARGET=http://127.0.0.1:5110
VITE_ALLOW_LAN=true

# 真实接口和图片识别密钥由研发后续接入；本文件不保存任何真实密钥。
