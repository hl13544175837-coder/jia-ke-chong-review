# 独立验收环境固定端口（由 scripts/start-isolated-demo.sh 管理）
BACKEND_PORT=5010
OAUTH_PORT=5110
FRONTEND_PORT=5190
OPERATIONS_PORT=5192

# 浏览器统一访问前端同源地址；Vite 仅在本机转发到下面两个服务。
LOCAL_BACKEND_PROXY_TARGET=http://127.0.0.1:5010
LOCAL_OAUTH_PROXY_TARGET=http://127.0.0.1:5110
VITE_ALLOW_LAN=true

# 5190 默认使用公司网关鉴权。只有自动化验收时才临时设置 READDY_AUTH_MODE=local。
READDY_AUTH_MODE=company
COMPANY_GATEWAY_PROXY_TARGET=https://pgsgw.yimidida.com
COMPANY_API_PROXY_TARGET=https://pgsgw.yimidida.com

# Apollo、JWT、MCP SSO、三方 Token 和图片识别密钥继续由现有环境、Apollo 或 CI 注入。
# 本文件和启动脚本都不保存、不覆盖、不清空任何真实密钥。
