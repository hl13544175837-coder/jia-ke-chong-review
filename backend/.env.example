# 智聘 · 招聘管理系统 — 环境配置模板
# 复制此文件为 .env 并填入真实值（.env 切勿提交版本库 / 切勿外泄）
# 几个人小范围真实数据试点时，也可以从 lightweight-pilot.env.example 开始复制。

# ── LLM 配置（与 base_agent/llm_config.json 对应）────────────────
# 主推荐字段：OPENAI_API_KEY。DeepSeek 使用 OpenAI 兼容接口，key 放这里即可。
# 为兼容旧模块，DEEPSEEK_API_KEY / API_KEY / LLM_API_KEY 可填同一个 key。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MAX_TOKENS=8192
# 图片简历使用独立的百炼视觉模型配置，Base URL 必须替换为实际业务空间地址。
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen3.7-plus
DASHSCOPE_VISION_TIMEOUT_S=120
# 上传请求只负责落库，模型在后台解析，避免被公司网关超时截断。
RESUME_PARSE_ASYNC_ENABLED=true
# AI 招聘合规：真实候选人数据进入 AI 前必须完成隐私告知、授权和人工复核规则确认
AI_RECRUITMENT_COMPLIANCE_ACK=false
CANDIDATE_PRIVACY_NOTICE_URL=
AI_HUMAN_REVIEW_REQUIRED=true
# AI 助手联网搜索默认关闭；开启后仍会阻止候选人隐私信息外发。
AGENT_WEB_SEARCH_ENABLED=false

# API Key（填你自己的；多个别名建议指向同一个 key，避免不同模块读不到）
OPENAI_API_KEY=sk-your-key-here
DEEPSEEK_API_KEY=sk-your-key-here
API_KEY=sk-your-key-here
LLM_API_KEY=sk-your-key-here

# JWT
# 生产必须改为强随机值（>=32 字符）；生成：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=8
# 外部 Agent 只导入简历的限时凭证，默认30天到期
AGENT_IMPORT_TOKEN_EXPIRY_DAYS=30

# 数据库（开发用 SQLite；公司试点/生产可改为 MySQL；mysql:// 会自动转为 PyMySQL 驱动）
DATABASE_URL=sqlite:///hireinsight.db
AUTO_MIGRATE_DATABASE=false
ALLOW_EMPTY_DATABASE_BOOTSTRAP=false

# 安全（生产/试点）
# 仅数据可丢弃的 RC/SIT 可在独立模板中开启；普通环境和生产保持 false
ALLOW_INSECURE_SIT_STARTUP=false
# 公开注册开关：生产保持 false，账号由 admin 创建
ALLOW_PUBLIC_REGISTRATION=false

# 网关统一鉴权模式：接入公司网关后鉴权在网关完成，后端不再校验自签 JWT。
# 开启后 require_auth 跳过 JWT，用默认用户身份（AUTH_DISABLED_USER_EMAIL，
# 留空取库中第一个在职 admin）。安全护栏：仅在 ALLOW_INSECURE_SIT_STARTUP=true
# 或 FLASK_DEBUG=true 时才真正生效；GA 启动门禁强制 AUTH_DISABLED=false。
# 生产/普通环境保持 false（走后端 JWT）。
AUTH_DISABLED=false
# 网关模式下当前用户身份：前端每个业务请求带 X-Emp-Code（网关工号），
# 后端按工号 find-or-create 一个用户（真实姓名/角色/组织随身份集成后续对接）。
# 自动建号时给的角色（无工号头时才回退到 AUTH_DISABLED_USER_EMAIL）：
# AUTH_GATEWAY_USER_ROLE=admin
# AUTH_DISABLED_USER_EMAIL=admin01@mvp.local
# CORS 白名单：生产必填，逗号分隔，如 https://zhipin.内网域名
CORS_ORIGINS=
# 应用侧兜底安全头和轻量限流；Nginx 层仍建议配置 limit_req
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_AGENT_CHAT=20
RATE_LIMIT_RESUME_UPLOAD=8
RATE_LIMIT_INTERVIEW_SUBMIT=10
# 本地直连保持 0；部署在一层 Nginx 后时改为 1。
TRUST_PROXY_HOPS=0
RATE_LIMIT_BUCKET_MAX=10000
INTERVIEW_QA_MAX_PAIRS=20
INTERVIEW_QA_MAX_QUESTION_LENGTH=1000
INTERVIEW_QA_MAX_ANSWER_LENGTH=5000
INTERVIEW_QA_MAX_TOTAL_LENGTH=30000

# 文件上传
UPLOAD_FOLDER=uploads

# 备份目录（配合 backend/scripts/backup_pilot_data.py）
BACKUP_DIR=../backups

# BOSS 直聘实验辅助能力：Cookie 用 Fernet 加密落库。/api/boss/* 已注册，测试/生产配置必须使用固定合法 key。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
BOSS_CLI_AUTO_INSTALL=false
BOSS_CLI_BIN=

# Celery（开发用 eager 模式，生产改为 redis://localhost:6379/0）
CELERY_BROKER_URL=memory://
CELERY_TASK_ALWAYS_EAGER=true

# ── Apollo 配置中心（携程 Apollo）──────────────────────────────────
# 启动时从 Apollo 拉配置注入环境变量，Config 透明读取（Apollo 里的 key 用应用的
# 环境变量名，如 DATABASE_URL / JWT_SECRET / LLM_API_KEY / CONSUL_HOST ...）。
# 默认关闭；不启用则完全走下面这些环境变量，不受影响。
APOLLO_ENABLED=false
# 地址来源优先级：APOLLO_SERVER_URL / APOLLO_META（运维注入，推荐）> 按 APOLLO_ENV 从
# 内置表兜底（dev/sit/fat/pre/pre_wx/pro/pro_wx）。运维注入了地址就无需依赖内置表。
# APOLLO_SERVER_URL=http://10.202.30.62:8080
# APOLLO_META=
# ⚠️ 未注入地址时才用 APOLLO_ENV 选址；APOLLO_ENV 未设默认 sit，生产等务必显式设置。
# APOLLO_ENV=sit
# appId 在代码里写死为 zhipin，此环境变量被忽略（服务器上曾被误配为 zhipin-mvp）。
# 如需恢复可配置，改 apollo_config.py 里 app_ids = ["zhipin"] 那行。
# APOLLO_APP_ID=zhipin  # 忽略
APOLLO_CLUSTER=default
# 多命名空间逗号分隔，按顺序合并（后者覆盖前者）
APOLLO_NAMESPACES=application
# 访问密钥（Apollo 配了 access key secret 时填；用 HMAC-SHA1 签名）
# APOLLO_SECRET=
# 覆盖策略：默认 false=环境变量优先（Apollo 只补缺失 key）；true=Apollo 覆盖同名环境变量。
# 注意：APOLLO_* 开头的引导参数永不被 Apollo 覆盖。
APOLLO_OVERRIDE_ENV=false
# Apollo 不可达时：默认记录日志并继续用环境变量启动；true=直接启动失败
APOLLO_FAIL_FAST=false

# ── 三方应用接口（银河 / 集团门户 / 乾坤）────────────────────────────
# 用 mcp.sso.token 调 MCP 登录换取员工三应用 token，再调各应用接口
# （见 app/services/third_party_service.py）。
# MCP 登录用的 sso token：留空则读 Apollo 注入的 `mcp.sso.token`
# MCP_SSO_TOKEN=
# MCP 登录服务前缀（默认 parktest 测试地址；按环境改）
# MCP_BASE_URL=https://parktest.yimidida.com/hrai/hr-ai-ms
# 三应用接口前缀（调用对应应用前必填）
# YH_BASE_URL=          # 银河
# GO_BASE_URL=          # 集团门户
# OMG_BASE_URL=         # 乾坤
# 三应用 token 头名（默认 token，按各应用要求改）
# YH_TOKEN_HEADER=token
# GO_TOKEN_HEADER=token
# OMG_TOKEN_HEADER=token
# MCP 登录结果缓存秒数（默认 300）
# THIRD_PARTY_LOGIN_TTL=300

# ── 服务注册中心（Consul / Eureka，二选一，动态切换）───────────────
# 默认两者都关 → 不注册（K8S 原生服务发现）。需要注册到公司注册中心时按下面开启。
# 也可用 REGISTRY_TYPE=consul|eureka|none 直接强制指定后端。
# 若想复用 Spring 服务那份 application.properties，设 REGISTRY_PROPERTIES_FILE 指向它，
# 支持 spring.cloud.consul.* / eureka.* 点号键（环境变量优先级更高）。
# REGISTRY_TYPE=
# REGISTRY_PROPERTIES_FILE=
CONSUL_ENABLED=false
EUREKA_ENABLED=false

# 注册的服务身份（对应 spring.application.name / server.port / prefer-ip-address）
SERVICE_NAME=zhipin-server
# SERVICE_PORT 留空则取 PORT；容器内为 5000
# SERVICE_PORT=5000
# SERVICE_IP 留空则自动探测“到注册中心的出口网卡”IP；多网卡/固定 IP 可显式指定
# SERVICE_IP=
SERVICE_PREFER_IP_ADDRESS=true
# 注册中心拉取的健康检查路径（本服务已提供 Spring 兼容的 /actuator/health）
HEALTH_CHECK_PATH=/actuator/health

# Consul（对应 spring.cloud.consul.*）
CONSUL_HOST=consul.tomcat.tomcat.01.sit
CONSUL_PORT=8500
CONSUL_SCHEME=http
CONSUL_REGISTER=true
# check 模式：http = Consul 主动回拉本服务（需 consul 能访问到本服务 ip:port，与 Spring 默认一致）
#            ttl  = 本服务主动上报心跳（consul 无法回拉本服务时用，如跨网段）
CONSUL_CHECK_MODE=http
CONSUL_HEALTH_INTERVAL=10s
# Consul ACL Token（如启用 ACL）
# CONSUL_TOKEN=

# Eureka（对应 eureka.client.* / eureka.instance.*，CONSUL_ENABLED=false 时启用）
# EUREKA_SERVER_URLS=http://eureka-1/eureka,http://eureka-2/eureka
# EUREKA_HEARTBEAT_INTERVAL=30

# Flask
# 仅本地开发显式开启；代码/容器默认为 false。
FLASK_DEBUG=true
# 仅 debug + SQLite 本地旧库兼容需要；试点/生产必须 false。
LOCAL_SCHEMA_COMPAT=true
# 开发联调固定 5001，前端 Vite 代理到此端口（见 RUNNING.md / vite.config.ts）
# 生产用 gunicorn -b 0.0.0.0:5000，由 Flask 同源托管 frontend/dist（见 DEPLOYMENT.md §6）
PORT=5001
