# 智聘 Test 小范围同事试用模板
# 仅用于公司内部、可回收测试数据的 RC/SIT。复制到部署平台后替换所有 REPLACE_*。

# 持久数据库和附件目录：不得使用 /tmp 或容器内临时 SQLite。
DATABASE_URL=mysql+pymysql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST:3306/zhipin_test
UPLOAD_FOLDER=/var/lib/zhipin/uploads
BACKUP_DIR=/var/lib/zhipin/backups

# 公司网关统一登录。工号不区分大小写；未配置人员默认招聘专员。
AUTH_DISABLED=true
AUTH_GATEWAY_USER_ROLE=recruiter
AUTH_GATEWAY_ROLE_MAP=REPLACE_ADMIN_EMP_CODE:admin,REPLACE_HR_EMP_CODE:recruiter,REPLACE_INTERVIEWER_1_EMP_CODE:interviewer,REPLACE_INTERVIEWER_2_EMP_CODE:interviewer,REPLACE_MANAGER_EMP_CODE:manager,REPLACE_DIRECTOR_EMP_CODE:hr_director
AUTH_DISABLED_USER_EMAIL=

# 本轮不测试模型简历解析。上传后保留原件并进入手动补录。
RESUME_AI_ENABLED=false
# RC 镜像默认关闭简历 AI。只有明确的 SIT 模型测试才在 Apollo 设为 true；GA 忽略此值。
SIT_RESUME_AI_ENABLED=false
# 开启模型时必须保持后台解析，避免多页简历超过网关等待时间。
RESUME_PARSE_ASYNC_ENABLED=true
AI_HUMAN_REVIEW_REQUIRED=true
AGENT_WEB_SEARCH_ENABLED=false
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_URL=
LLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
API_KEY=

# 固定密钥由部署平台注入，不得使用本文件示例字面值。
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
FIELD_ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY
JWT_EXPIRY_HOURS=8

# RC/SIT 允许网关模式和单实例启动前迁移；禁止应用运行时补表。
FLASK_DEBUG=false
ALLOW_INSECURE_SIT_STARTUP=true
AUTO_MIGRATE_DATABASE=true
ALLOW_EMPTY_DATABASE_BOOTSTRAP=true
LOCAL_SCHEMA_COMPAT=false
ALLOW_PUBLIC_REGISTRATION=false

# 只允许公司 Test 前端来源；网关如同域转发也可按实际域名调整。
CORS_ORIGINS=https://test-zhipin.yimidida.com
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_AGENT_CHAT=20
RATE_LIMIT_RESUME_UPLOAD=8
RATE_LIMIT_INTERVIEW_SUBMIT=10
TRUST_PROXY_HOPS=1
RATE_LIMIT_BUCKET_MAX=10000
INTERVIEW_QA_MAX_PAIRS=20
INTERVIEW_QA_MAX_QUESTION_LENGTH=1000
INTERVIEW_QA_MAX_ANSWER_LENGTH=5000
INTERVIEW_QA_MAX_TOTAL_LENGTH=30000

# 公司 SIT 服务注册。
CONSUL_ENABLED=true
EUREKA_ENABLED=false
CONSUL_HOST=consul.tomcat.tomcat.01.sit
CONSUL_PORT=8500
CONSUL_CHECK_MODE=ttl
SERVICE_NAME=zhipin-server
SERVICE_PORT=5000

BOSS_CLI_AUTO_INSTALL=false
BOSS_CLI_BIN=
CELERY_BROKER_URL=memory://
CELERY_TASK_ALWAYS_EAGER=true
PORT=5000
