# 智聘 RC/SIT 完全放行模板
# 仅用于单人、数据可丢弃的测试环境。可直接复制为 backend/.env。
# 不含真实密钥；不得用于真实候选人数据或生产环境。

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MAX_TOKENS=8192
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
API_KEY=
LLM_API_KEY=

AI_RECRUITMENT_COMPLIANCE_ACK=false
CANDIDATE_PRIVACY_NOTICE_URL=
AI_HUMAN_REVIEW_REQUIRED=false

JWT_SECRET=sit-disposable-not-a-real-secret
JWT_EXPIRY_HOURS=8

DATABASE_URL=sqlite:////tmp/zhipin-sit.db
UPLOAD_FOLDER=/tmp/zhipin_uploads
BACKUP_DIR=/tmp/zhipin_backups

# 显式放行：不用 debug，不跑启动安全门禁，开放 CORS/注册，关闭安全头和限流。
FLASK_DEBUG=false
ALLOW_INSECURE_SIT_STARTUP=true
CORS_ORIGINS=
ALLOW_PUBLIC_REGISTRATION=true
SECURITY_HEADERS_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN=10
RATE_LIMIT_AGENT_CHAT=20
RATE_LIMIT_RESUME_UPLOAD=8

# SIT 现场验收通知前必须替换域名并由部署变量注入 Webhook 密钥。
PUBLIC_APP_BASE_URL=
INTERVIEW_NOTIFICATION_WEBHOOK_URL=
INTERVIEW_NOTIFICATION_WEBHOOK_MODE=wecom
INTERVIEW_ACCESS_TOKEN_TTL_HOURS=72
INTERVIEW_NOTIFICATION_TIMEOUT_SECONDS=5

# 可丢弃 SIT 允许空库初始化和启动前迁移；不开启应用内本地兼容 DDL。
AUTO_MIGRATE_DATABASE=true
ALLOW_EMPTY_DATABASE_BOOTSTRAP=true
LOCAL_SCHEMA_COMPAT=false

FIELD_ENCRYPTION_KEY=
BOSS_CLI_AUTO_INSTALL=false
BOSS_CLI_BIN=

CELERY_BROKER_URL=memory://
CELERY_TASK_ALWAYS_EAGER=true
PORT=5000
