# 智聘真实数据内部小范围试用配置模板
# 用法：复制为 backend/.env，替换全部 REPLACE_* 值；真实 .env 不得提交 Git。
# 本档位关闭 AI 和网关免 JWT，只验证招聘需求、简历入库、流程、面试、Offer、看板。

RESUME_AI_ENABLED=false
RESUME_PARSE_ASYNC_ENABLED=false
AI_HUMAN_REVIEW_REQUIRED=true
AGENT_WEB_SEARCH_ENABLED=false

# 使用系统账号和 JWT 登录。真实数据试用不得开启宽松的 AUTH_DISABLED 网关模式。
AUTH_DISABLED=false
ALLOW_INSECURE_SIT_STARTUP=false
ALLOW_PUBLIC_REGISTRATION=false

# 生成强随机值：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
JWT_EXPIRY_HOURS=8

# 真实试用只使用 MySQL 或 PostgreSQL；账号只授予智聘所需库权限。
DATABASE_URL=mysql+pymysql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST:3306/zhipin_trial?charset=utf8mb4
AUTO_MIGRATE_DATABASE=false
ALLOW_EMPTY_DATABASE_BOOTSTRAP=false
LOCAL_SCHEMA_COMPAT=false

# 填写公司内部实际访问 origin，不带路径、参数或通配符。
CORS_ORIGINS=https://REPLACE_TRIAL_HOST
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_AGENT_CHAT=20
RATE_LIMIT_RESUME_UPLOAD=8
RATE_LIMIT_INTERVIEW_SUBMIT=10
TRUST_PROXY_HOPS=1

# 必须是 Pod/服务器重启后仍保留且可写的绝对路径。
UPLOAD_FOLDER=/var/lib/zhipin/uploads
BACKUP_DIR=/var/backups/zhipin

# 生成固定 Fernet key：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FIXED_FERNET_KEY
BOSS_CLI_AUTO_INSTALL=false
BOSS_CLI_BIN=

CELERY_BROKER_URL=memory://
CELERY_TASK_ALWAYS_EAGER=true
FLASK_DEBUG=false
PORT=5000
